# Generated private installation configuration lives OUTSIDE the source checkout.
INSTALL_DIRECTORY=/srv/memlia
PUBLIC_ORIGIN=https://memlia.cabinet.example
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3000
# false in cabinet; true allows ONLY an explicit localhost HTTP test origin.
ALLOW_HTTP_LOOPBACK=false
MEMLIA_IMAGE=memlia-cabinet:local
